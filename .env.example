# --- Required in production -------------------------------------------------
# Signs session cookies. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# --- Optional ---------------------------------------------------------------
# Enables LLM-written fit reasoning and intro drafts. Without it the app falls
# back to deterministic template drafts (clearly labelled in the UI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shows the sample matchmaker logins on the sign-in screen (demo deployments only).
SHOW_DEMO_CREDENTIALS=true
